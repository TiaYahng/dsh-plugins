{
  "name": "dsh-comprehensive-platform",
  "version": "0.1.0",
  "description": "DSH Desktop platform page: usage statistics, session archive restore, and per-workspace memory management behind one Settings section.",
  "keywords": [
    "dsh-plugin",
    "dsh",
    "deepseek-harness",
    "settings",
    "usage",
    "memory",
    "sessions"
  ],
  "homepage": "https://github.com/TiaYahng/dsh-plugins#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TiaYahng/dsh-plugins.git"
  },
  "private": true,
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "dsh": "^0.1.5-rc.2 || ^0.2.0-rc.1",
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-api-remotes"
      ],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-client-ui-settings": "^0.1.5-rc.2 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-home-paths": "^0.1.5-rc.2 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-host-webserver": "^0.1.5-rc.2 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-session-persistence": "^0.1.5-rc.2 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-settings": "^0.1.5-rc.2 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-workspace": "^0.1.5-rc.2 || ^0.2.0-rc.1",
    "dsh-our-free-model": "^2.1.0"
  },
  "peerDependenciesMeta": {
    "dsh-our-free-model": {
      "optional": true
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.2",
    "yaml": "^2.4.0"
  }
}
